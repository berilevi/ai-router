# Server Configuration
PORT=11434
NODE_ENV=development
LOG_LEVEL=info

# Gemini Web Automation (Puppeteer)
# Set to "true" to enable browser automation for gemini.google.com
GEMINI_WEB_ENABLED=true
# Your Google account credentials (only needed if not already logged in)
GOOGLE_EMAIL=
GOOGLE_PASSWORD=
# Path to Chrome executable (optional, will use bundled Chromium if not set)
CHROME_EXECUTABLE_PATH=
# Headless mode (set to "false" for debugging)
PUPPETEER_HEADLESS=true

# Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
# Default Gemini model to use
GEMINI_DEFAULT_MODEL=gemini-1.5-flash-latest

# OpenAI-compatible API Configuration
# Supports OpenAI, Azure OpenAI, and any OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Additional OpenAI-compatible Providers
# Format: PROVIDER_NAME_API_KEY, PROVIDER_NAME_BASE_URL, PROVIDER_NAME_DEFAULT_MODEL
# Example for Anthropic via OpenAI-compatible proxy:
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Anthropic Provider Mode
# Options: native, compatible, auto (default)
# - native: Always use Anthropic SDK directly (recommended for best compatibility)
# - compatible: Always use OpenAI-compatible wrapper (requires compatible proxy)
# - auto: Use native SDK
ANTHROPIC_PROVIDER_MODE=auto

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Request Timeout (milliseconds)
REQUEST_TIMEOUT=300000

# Streaming Configuration
STREAM_CHUNK_SIZE=1024
STREAM_DELAY_MS=10
