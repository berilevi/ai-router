# Server Configuration
PORT=11434
NODE_ENV=development
LOG_LEVEL=info

# Gemini Web Automation (Puppeteer)
# Set to "true" to enable browser automation for gemini.google.com
GEMINI_WEB_ENABLED=true
# Your Google account credentials (only needed if not already logged in)
GOOGLE_EMAIL=
GOOGLE_PASSWORD=
# Path to Chrome executable (optional, will use bundled Chromium if not set)
CHROME_EXECUTABLE_PATH=
# Headless mode (set to "false" for debugging)
PUPPETEER_HEADLESS=true

# Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
# Default Gemini model to use
GEMINI_DEFAULT_MODEL=gemini-1.5-flash-latest

# OpenAI-compatible API Configuration
# Supports OpenAI, Azure OpenAI, and any OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Anthropic Configuration (Native SDK)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: Custom base URL (defaults to https://api.anthropic.com)
ANTHROPIC_BASE_URL=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5-20250929

# GitHub Copilot Provider Configuration
# Set to "true" to enable Copilot as a backend provider
COPILOT_ENABLED=true
# Default model for Copilot (available: gpt5, gpt-4.1, opus, sonnet, haiku, o1, o3, o3-mini)
COPILOT_DEFAULT_MODEL=gpt-4.1
# Session TTL in milliseconds (default: 30 minutes)
COPILOT_SESSION_TTL=1800000
# Enable request/response logging
COPILOT_LOG_REQUESTS=false
COPILOT_LOG_RESPONSES=false
COPILOT_LOG_DIR=./logs/copilot

# GitHub Authentication for Copilot (checked in order)
# Option 1: Explicit Copilot token
COPILOT_GITHUB_TOKEN=
# Option 2: Standard GitHub token (also used by gh CLI)
GH_TOKEN=
# Option 3: No env vars - will fall back to GitHub CLI (gh) authentication

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Request Timeout (milliseconds)
REQUEST_TIMEOUT=300000

# Streaming Configuration
STREAM_CHUNK_SIZE=1024
STREAM_DELAY_MS=10

# Response Caching Configuration
# Enable/disable caching (default: true)
CACHE_ENABLED=true
# Cache TTL in milliseconds (default: 1 hour = 3600000)
CACHE_TTL_MS=3600000
# Maximum cache size in bytes (default: 100MB)
CACHE_MAX_SIZE_BYTES=104857600
# Maximum number of cache entries (default: 1000)
CACHE_MAX_ENTRIES=1000
# Cache eviction strategy: lru (least recently used) or fifo (default: lru)
CACHE_STRATEGY=lru

# =============================================================================
# Load Balancing & High Availability Configuration
# =============================================================================

# Circuit Breaker Configuration
# Number of consecutive failures before circuit opens (default: 5)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# Time in seconds before circuit transitions from OPEN to HALF_OPEN (default: 60)
CIRCUIT_BREAKER_TIMEOUT=60

# Rate Limit Manager Configuration
# Default retry delay in seconds when 429 is received without Retry-After header (default: 60)
RATE_LIMIT_DEFAULT_RETRY=60

# API Key Rotation Configuration
# Number of consecutive failures before key is disabled (default: 5)
KEY_ROTATION_FAILURE_THRESHOLD=5
# Time in seconds to disable a key after failures (default: 300 = 5 min)
KEY_ROTATION_DISABLE_TIMEOUT=300

# Multiple API Keys per Provider (comma-separated)
# Enables round-robin load balancing between keys
# OPENAI_API_KEYS=sk-key1,sk-key2,sk-key3
# ANTHROPIC_API_KEYS=sk-ant-key1,sk-ant-key2
# GEMINI_API_KEYS=key1,key2

# Model Fallback Chains (JSON format)
# Define fallback order when primary provider is rate-limited or unavailable
# MODEL_FALLBACK_CHAINS='{"claude":{"primary":{"provider":"anthropic","model":"claude-sonnet-4-5-20250929"},"fallbacks":[{"provider":"openai","model":"gpt-4o","priority":1}]}}'
