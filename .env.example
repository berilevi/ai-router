# Server Configuration
PORT=11434
NODE_ENV=development
LOG_LEVEL=info

# Gemini Web Automation (Puppeteer)
# Set to "true" to enable browser automation for gemini.google.com
GEMINI_WEB_ENABLED=true
# Your Google account credentials (only needed if not already logged in)
GOOGLE_EMAIL=
GOOGLE_PASSWORD=
# Path to Chrome executable (optional, will use bundled Chromium if not set)
CHROME_EXECUTABLE_PATH=
# Headless mode (set to "false" for debugging)
PUPPETEER_HEADLESS=true

# Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
# Default Gemini model to use
GEMINI_DEFAULT_MODEL=gemini-1.5-flash-latest

# OpenAI-compatible API Configuration
# Supports OpenAI, Azure OpenAI, and any OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Anthropic Configuration (Native SDK)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: Custom base URL (defaults to https://api.anthropic.com)
ANTHROPIC_BASE_URL=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# GitHub Copilot Provider Configuration
# Set to "true" to enable Copilot as a backend provider
COPILOT_ENABLED=true
# Default model for Copilot (available: gpt5, gpt-4.1, opus, sonnet, haiku, o1, o3, o3-mini)
COPILOT_DEFAULT_MODEL=gpt-4.1
# Session TTL in milliseconds (default: 30 minutes)
COPILOT_SESSION_TTL=1800000
# Enable request/response logging
COPILOT_LOG_REQUESTS=false
COPILOT_LOG_RESPONSES=false
COPILOT_LOG_DIR=./logs/copilot

# GitHub Authentication for Copilot (checked in order)
# Option 1: Explicit Copilot token
COPILOT_GITHUB_TOKEN=
# Option 2: Standard GitHub token (also used by gh CLI)
GH_TOKEN=
# Option 3: No env vars - will fall back to GitHub CLI (gh) authentication

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Request Timeout (milliseconds)
REQUEST_TIMEOUT=300000

# Streaming Configuration
STREAM_CHUNK_SIZE=1024
STREAM_DELAY_MS=10
