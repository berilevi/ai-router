# =============================================================================
# AI Router - Complete Configuration Reference
# =============================================================================
# This file documents ALL configuration options supported by AI Router.
# Copy this to .env in the project root and customize for your environment.
#
# Documentation: See README.md and docs/ folder for detailed guides.
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port the server listens on (default: 11434 for Ollama compatibility)
PORT=11434

# Environment mode: development, production, or test
# - development: verbose logging, error details exposed
# - production: minimal logging, errors sanitized
# - test: optimized for automated testing
NODE_ENV=development

# Logging verbosity: error, warn, info, debug, trace
# - error: critical errors only
# - warn: warnings and errors
# - info: general operational info (recommended for production)
# - debug: detailed debugging info
# - trace: extremely verbose, includes request/response bodies
LOG_LEVEL=info

# =============================================================================
# RATE LIMITING
# =============================================================================

# Time window for rate limiting in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests allowed per window (default: 100)
# Set higher for high-traffic deployments
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# REQUEST HANDLING
# =============================================================================

# Maximum time to wait for a response in milliseconds (default: 300000 = 5 min)
# Increase for complex prompts or slow providers
REQUEST_TIMEOUT=300000

# Streaming response chunk size in bytes (default: 1024)
STREAM_CHUNK_SIZE=1024

# Delay between streaming chunks in milliseconds (default: 10)
# Increase to reduce CPU usage, decrease for faster streaming
STREAM_DELAY_MS=10

# =============================================================================
# RESPONSE CACHING
# =============================================================================
# In-memory LRU cache for identical requests. Reduces costs and latency.
# See docs/CACHE_IMPLEMENTATION.md for details.

# Enable/disable response caching (default: true)
CACHE_ENABLED=true

# Cache entry TTL in milliseconds (default: 3600000 = 1 hour)
# Cached responses expire after this time
CACHE_TTL_MS=3600000

# Maximum total cache size in bytes (default: 104857600 = 100MB)
# Oldest entries evicted when limit reached
CACHE_MAX_SIZE_BYTES=104857600

# Maximum number of cached entries (default: 1000)
# Prevents memory bloat from many small responses
CACHE_MAX_ENTRIES=1000

# Cache eviction strategy (default: lru)
# - lru: Least Recently Used - evicts least-accessed entries first
# - fifo: First In First Out - evicts oldest entries first
CACHE_STRATEGY=lru

# =============================================================================
# PROVIDER: ANTHROPIC (Native SDK)
# =============================================================================
# Uses the official @anthropic-ai/sdk for best compatibility.
# Supports: Messages API, Streaming, Tool Calling, Vision, Prompt Caching,
#           Message Batches API
# Models: claude-sonnet-4-5-20250929, claude-haiku-4.5, claude-opus-4-5-20250604
# Get API key: https://console.anthropic.com/

# Your Anthropic API key (required to enable this provider)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Custom base URL (optional, defaults to https://api.anthropic.com)
# Use for proxies or enterprise deployments
ANTHROPIC_BASE_URL=

# Default model when none specified (default: claude-sonnet-4-5-20250929)
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5-20250929

# =============================================================================
# PROVIDER: OPENAI
# =============================================================================
# OpenAI-compatible provider. Also works with Azure OpenAI and compatible APIs.
# Supports: Chat Completions, Streaming, Tool Calling, Vision, Embeddings
# Models: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-4, gpt-3.5-turbo
# Get API key: https://platform.openai.com/api-keys

# Your OpenAI API key (required to enable this provider)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL for the API (default: https://api.openai.com/v1)
# Change for Azure OpenAI: https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT
# Change for compatible APIs: https://api.together.xyz/v1, etc.
OPENAI_BASE_URL=https://api.openai.com/v1

# Default model when none specified (default: gpt-4o-mini)
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# =============================================================================
# PROVIDER: GITHUB COPILOT
# =============================================================================
# Routes requests through GitHub Copilot's API using your GitHub subscription.
# Supports: Chat, Streaming, multiple model backends
# Models: gpt5, gpt-4.1, opus, sonnet, haiku, o1, o3, o3-mini
# Requires: Active GitHub Copilot subscription

# Enable Copilot as a backend provider (default: false)
COPILOT_ENABLED=true

# Default model for Copilot requests (default: gpt-4.1)
# Available: gpt5, gpt-4.1, opus, sonnet, haiku, o1, o3, o3-mini
COPILOT_DEFAULT_MODEL=gpt-4.1

# Session TTL in milliseconds (default: 1800000 = 30 minutes)
# Sessions are reused within this window for efficiency
COPILOT_SESSION_TTL=1800000

# Enable request logging for debugging (default: false)
# WARNING: May log sensitive data - use only for debugging
COPILOT_LOG_REQUESTS=false

# Enable response logging for debugging (default: false)
COPILOT_LOG_RESPONSES=false

# Directory for Copilot logs (default: ./logs/copilot)
COPILOT_LOG_DIR=./logs/copilot

# GitHub authentication for Copilot (checked in priority order):
# Option 1: Explicit Copilot token (highest priority)
COPILOT_GITHUB_TOKEN=

# Option 2: Standard GitHub token (also used by gh CLI)
GH_TOKEN=

# Option 3: If neither env var is set, falls back to GitHub CLI (gh) authentication
# Ensure you're logged in with: gh auth login

# =============================================================================
# PROVIDER: GEMINI API
# =============================================================================
# Google's official Generative AI API.
# Supports: Chat, Streaming, Vision, Tool Calling, Embeddings
# Models: gemini-1.5-flash-latest, gemini-1.5-flash-8b-latest, gemini-1.5-pro-latest
# Get API key: https://makersuite.google.com/app/apikey

# Your Gemini API key (required to enable this provider)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default Gemini model (default: gemini-1.5-flash-latest)
GEMINI_DEFAULT_MODEL=gemini-1.5-flash-latest

# =============================================================================
# PROVIDER: GEMINI WEB (Browser Automation)
# =============================================================================
# Access Gemini through browser automation (Puppeteer).
# Useful for accessing Gemini Pro subscription features without API.
# Supports: Chat, Streaming, Vision (limited)
# WARNING: May break if Google updates their UI. See TODO #1.

# Enable Gemini Web automation (default: false)
GEMINI_WEB_ENABLED=false

# Google account credentials for browser login
# Only needed if not already logged in via saved session
GOOGLE_EMAIL=your-email@gmail.com
GOOGLE_PASSWORD=your-google-password

# Path to Chrome/Chromium executable (optional)
# If not set, uses bundled Chromium from Puppeteer
CHROME_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Run browser in headless mode (default: true)
# Set to false for debugging - will show browser window
PUPPETEER_HEADLESS=true

# =============================================================================
# ANTHROPIC-SPECIFIC FEATURES
# =============================================================================
# These features are available when using the Anthropic provider.
# See docs/PROMPT_CACHING.md and docs/MESSAGE_BATCHES.md for details.

# --- Prompt Caching ---
# Reduce costs by up to 90% for repeated prompt prefixes.
# Usage: Add "enableCache": true to your request body.
# Caching is handled by Anthropic's servers with 5-minute TTL.
# Minimum 1024 tokens required to trigger caching.
#
# Example request:
# {
#   "model": "claude-sonnet-4-5-20250929",
#   "enableCache": true,
#   "cacheBreakpoints": [0, 2],  // Cache messages at these indices
#   "messages": [...]
# }

# --- Message Batches API ---
# Process up to 10,000 requests in a batch with 50% cost discount.
# Batches complete within 24 hours.
#
# Endpoints:
#   POST   /v1/messages/batches          - Create batch
#   GET    /v1/messages/batches          - List batches
#   GET    /v1/messages/batches/:id      - Get batch status
#   GET    /v1/messages/batches/:id/results - Get results (JSONL)
#   POST   /v1/messages/batches/:id/cancel  - Cancel batch

# =============================================================================
# API ENDPOINTS REFERENCE
# =============================================================================
# All endpoints are available at http://localhost:{PORT}/
#
# --- Ollama-Compatible Endpoints ---
# POST /api/chat           - Chat completion (Ollama format)
# POST /api/generate       - Text generation (Ollama format)
# GET  /api/tags           - List available models
# POST /api/embeddings     - Generate embeddings
#
# --- Anthropic-Compatible Endpoints ---
# POST /v1/messages        - Messages API (Anthropic format)
# POST /v1/messages/batches - Batch processing
#
# --- Metrics & Health ---
# GET  /health             - Health check (Kubernetes-ready)
# GET  /metrics            - Prometheus metrics
# GET  /metrics/json       - JSON metrics
# GET  /metrics/summary    - Human-readable summary
#
# --- Cache Management ---
# GET  /cache/stats        - Cache statistics
# POST /cache/clear        - Clear response cache

# =============================================================================
# MODEL ALIASES
# =============================================================================
# You can use these short names in your requests:
#
# Anthropic:
#   claude, claude-sonnet -> claude-sonnet-4-5-20250929
#   claude-haiku         -> claude-haiku-4.5
#   claude-opus          -> claude-opus-4-5-20250604
#
# OpenAI:
#   gpt-4o, gpt-4o-mini, gpt-4, gpt-3.5-turbo
#
# Gemini:
#   gemini, gemini-pro, gemini-flash, gemini-1.5-flash, gemini-1.5-pro
#
# Copilot:
#   gpt5, gpt-4.1, opus, sonnet, haiku, o1, o3, o3-mini
#   gpt-5, gpt5-latest -> gpt5
#   gpt4.1, gpt-4.1-turbo -> gpt-4.1

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Never commit this file with real credentials to version control
# 2. Use environment variables or secrets management in production
# 3. Restrict file permissions: chmod 600 .env
# 4. Consider using a vault service (HashiCorp Vault, AWS Secrets Manager)
# 5. Rotate API keys periodically
# 6. The router itself has no authentication - see TODO #4 for future plans

# =============================================================================
# TROUBLESHOOTING
# =============================================================================
# Provider not working?
#   - Check API key is set and valid
#   - Verify provider is enabled (some require explicit ENABLED=true)
#   - Check logs: LOG_LEVEL=debug for more detail
#
# Slow responses?
#   - Enable caching: CACHE_ENABLED=true
#   - Use faster models: claude-haiku, gpt-4o-mini, gemini-flash
#   - Increase timeout: REQUEST_TIMEOUT
#
# Rate limited?
#   - Adjust RATE_LIMIT_* settings
#   - Use response caching to reduce duplicate requests
#   - Consider Message Batches API for bulk operations
#
# Cache not working?
#   - Verify CACHE_ENABLED=true
#   - Check requests aren't streaming (stream:true bypasses cache)
#   - Tool-calling requests are not cached
#   - Check /cache/stats for hit/miss rates
