# =============================================================================
# AI Router - Production Configuration with Copilot + OpenAI Fallback
# =============================================================================
# This example shows a production setup using:
# - GitHub Copilot as primary (free/included with subscription)
# - OpenAI as fallback (paid, but with caching optimization)
# - All global optimization features enabled
#
# Cost Strategy:
# 1. Try Copilot first (free tier) - sonnet, opus, haiku
# 2. Fall back to OpenAI (with caching) - 90% cheaper cached tokens
#
# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

PORT=11434
NODE_ENV=production
LOG_LEVEL=info

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# REQUEST HANDLING
# =============================================================================

REQUEST_TIMEOUT=300000
STREAM_CHUNK_SIZE=1024
STREAM_DELAY_MS=10

# =============================================================================
# RESPONSE CACHING (Router's In-Memory Cache)
# =============================================================================
# Caches identical API responses to eliminate duplicate API calls

CACHE_ENABLED=true
CACHE_TTL_MS=3600000           # 1 hour
CACHE_MAX_SIZE_BYTES=104857600 # 100MB
CACHE_MAX_ENTRIES=1000
CACHE_STRATEGY=lru

# =============================================================================
# LOAD BALANCING & HIGH AVAILABILITY
# =============================================================================

# Circuit Breaker - prevents cascading failures
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5    # Open after 5 failures
CIRCUIT_BREAKER_TIMEOUT=60             # Retry after 60 seconds

# Rate Limit Manager - handles 429 errors gracefully
RATE_LIMIT_DEFAULT_RETRY=60            # Default 60s retry if no Retry-After header

# API Key Rotation - round-robin between multiple keys
KEY_ROTATION_FAILURE_THRESHOLD=5       # Disable key after 5 failures
KEY_ROTATION_DISABLE_TIMEOUT=300       # Re-enable after 5 minutes

# Multiple API Keys per Provider (enables round-robin load balancing)
# OPENAI_API_KEYS=sk-key1,sk-key2,sk-key3
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# GITHUB COPILOT CONFIGURATION
# =============================================================================
# Primary provider - free/included with GitHub subscription
# Supports: sonnet, haiku, opus (and other models)

COPILOT_ENABLED=true
COPILOT_DEFAULT_MODEL=sonnet

# Session management
COPILOT_SESSION_TTL=1800000  # 30 minutes

# Authentication (choose one method)
# Option 1: Explicit Copilot token
COPILOT_GITHUB_TOKEN=

# Option 2: Standard GitHub token
GH_TOKEN=

# Option 3: No env vars - uses GitHub CLI (gh) authentication

# Logging (for debugging, keep disabled in production)
COPILOT_LOG_REQUESTS=false
COPILOT_LOG_RESPONSES=false
COPILOT_LOG_DIR=./logs/copilot

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
# Fallback provider - used when Copilot is rate limited or unavailable
# Supports: gpt-4o, gpt-4o-mini, gpt-4-turbo, etc.

OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o

# =============================================================================
# ANTHROPIC CONFIGURATION (Optional - Not Used in This Example)
# =============================================================================
# Can be enabled as secondary fallback if needed

# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5-20250929

# =============================================================================
# ANTHROPIC-SPECIFIC: PROMPT CACHING (Global Settings)
# =============================================================================
# Reduces costs by 90% for repeated prompt prefixes
# Note: Anthropic only - OpenAI uses response caching instead

# Enable automatic prompt caching (default: true)
ANTHROPIC_ENABLE_CACHE=true

# Minimum tokens to enable caching (default: 1024, Anthropic's minimum)
ANTHROPIC_CACHE_MIN_TOKENS=1024

# Auto-cache system prompts (default: true, recommended)
# System prompts rarely change between requests (high reuse rate = cost savings)
ANTHROPIC_CACHE_SYSTEM_PROMPT=true

# Auto-cache last user message (default: false, keep disabled)
# User messages are typically unique (low reuse rate = cost increase)
# Cache writes cost 25% MORE than regular tokens - only enable for special cases
ANTHROPIC_CACHE_LAST_MESSAGE=false

# =============================================================================
# MODEL FALLBACK CHAIN
# =============================================================================
# Priority-ordered array of models to try. Index 0 = highest priority.
# Router walks through array until finding a working provider.
#
# Strategy:
# 1. Try Copilot first (free - sonnet, opus, haiku)
# 2. Fall back to OpenAI (paid - gpt-4o, gpt-4o-mini)
#
# When a provider is rate limited or circuit opens, automatically move to next

MODEL_FALLBACK_CHAIN='[
  { "model": "sonnet", "provider": "copilot" },
  { "model": "opus", "provider": "copilot" },
  { "model": "haiku", "provider": "copilot" },
  { "model": "gpt-4o", "provider": "openai" },
  { "model": "gpt-4o-mini", "provider": "openai" }
]'

# =============================================================================
# COST OPTIMIZATION SUMMARY
# =============================================================================
#
# Layer 1: Router Response Cache
# - Caches identical responses in memory
# - Eliminates duplicate API calls
# - Zero latency, zero cost
#
# Layer 2: Copilot (Primary)
# - Free tier with GitHub subscription
# - Unlimited usage (fair use policy)
# - No per-token costs
#
# Layer 3: OpenAI (Fallback)
# - Falls back only when Copilot unavailable
# - Router response cache still active
# - If Anthropic were enabled: 90% cheaper cached tokens
#
# Result: Minimal API calls, free primary tier, caching everywhere
#
# =============================================================================
